PORT=8080
DATABASE_URL=postgresql://animes:animes@localhost:5432/animes

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack. Deixe SQS_QUEUE_URL e S3_BUCKET vazios para rodar só o CRUD.
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/anime-events
SQS_QUEUE_NAME=anime-events
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=animes-covers
S3_PUBLIC_BASE_URL=http://localhost:4566/animes-covers
